# Copy backend values to backend/.env
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/probashicare
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Optional Google Calendar integration for doctor appointments.
# Share GOOGLE_CALENDAR_ID with GOOGLE_SERVICE_ACCOUNT_EMAIL and grant
# "Make changes to events" before running: npm run test:calendar --prefix backend
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-shared-calendar-id@group.calendar.google.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
# For Gmail, use a Google App Password here, not the normal account password.
# Render Free blocks ports 25, 465, and 587. For a hosted demo, use a provider
# such as Brevo with SMTP_HOST=smtp-relay.brevo.com and SMTP_PORT=2525.
SMTP_PASS=your-smtp-password
MAIL_FROM=ProbashiCare <no-reply@example.com>
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
REQUIRE_CAREGIVER_DOCUMENT=false
PROTOTYPE_PAYMENTS_ENABLED=true
# Stripe-hosted Checkout sandbox. Keep disabled until test keys are configured.
STRIPE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
# Local: obtain this from `stripe listen --forward-to localhost:5000/api/subscriptions/stripe/webhook`.
# Hosted: use the separate signing secret shown for the public Stripe Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_local_webhook_secret
ALLOW_EARLY_BOOKING_COMPLETION=true
FAMILY_TRIAL_DAYS=7
SUBSCRIPTION_CURRENCY=BDT
GEMINI_API_KEY=your-development-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest
STORE_LOCATOR_USER_AGENT="ProbashiCareStudentProject/1.0 (public-contact@example.com)"

# Used only by `npm run seed:admin --prefix backend`
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Copy frontend values to frontend/.env
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Set this to 75000 on Vercel so the first request can survive a Render cold start.
VITE_API_TIMEOUT_MS=12000
